{
  "name": "bid-service",
  "version": "0.1.0",
  "private": true,
  "description": "BidStream bid-service: supplier bids over gRPC, outbox relay to bid.events, rfq.events consumer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "grpc-health-check": "2.1.0",
    "kafkajs": "2.2.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "snappyjs": "0.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
